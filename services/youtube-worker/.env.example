NODE_ENV=production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
REDIS_URL=redis://:PASSWORD@HOST:PORT
TOKEN_ENCRYPTION_KEY=64_HEX_CHARACTERS_FOR_32_BYTES
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=YOUR_MODEL_KEY
MODEL_NAME=YOUR_MODEL_NAME
# Optional: leave empty when SEARXNG_BASE_URL is configured.
TAVILY_API_KEY=
SEARXNG_BASE_URL=
PEXELS_API_KEY=YOUR_PEXELS_KEY
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY
ELEVENLABS_VOICE_ID=YOUR_AUTHORIZED_VOICE_ID
# Whisper-compatible endpoint; defaults preserve the OpenAI route.
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# OPENAI_API_KEY remains a backward-compatible fallback for Whisper credentials.
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_API_DOMAIN/v1/youtube/oauth/callback
VIDEO_COST_ESTIMATE_USD=1.50
MIN_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_DURATION_SECONDS=900
