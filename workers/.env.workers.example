# Copy to workers/.env.workers (never commit the real secrets).
REDIS_PASSWORD=replace-with-long-alphanumeric-secret

# Use separate long random secrets. Match each corresponding Vercel worker secret.
VOICE_WORKER_API_KEY=replace-with-a-different-secret
MEDIA_WORKER_API_KEY=replace-with-a-different-secret
YOUTUBE_WORKER_API_KEY=replace-with-a-different-secret
CHANNEL_WORKER_API_KEY=replace-with-a-different-secret
AGENT_WORKER_API_KEY=replace-with-a-different-secret
AUTOMATION_WORKER_API_KEY=replace-with-a-different-secret
REA_WORKER_API_KEY=replace-with-a-different-secret
REA_JOB_TIMEOUT_SECONDS=180


# Voice/model licensing: keep noncommercial unless model/checkpoint documentation and rights explicitly allow commercial use.
F5_TTS_MODEL=F5TTS_v1_Base
F5_TTS_MODEL_LICENSE_CLASS=noncommercial
F5_TTS_JOB_TIMEOUT_SECONDS=240

# Optional media generation via a separately hosted ComfyUI instance.
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COMFYUI_JOB_TIMEOUT_SECONDS=900
MEDIA_MAX_UPLOAD_BYTES=2147483648

# Optional ASR worker endpoint.
ASR_WORKER_URL=
ASR_WORKER_API_KEY=

# YouTube OAuth. Use OAuth consent and a refresh token belonging to the channel owner.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_CONNECTION_ID=
YOUTUBE_DEFAULT_CATEGORY_ID=22

# Configure only channels used; all target IDs must be allowlisted server-side.
TELEGRAM_CONNECTION_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_TARGET_IDS=
DISCORD_CONNECTION_ID=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_TARGET_IDS=
SLACK_CONNECTION_ID=
SLACK_BOT_TOKEN=
SLACK_ALLOWED_TARGET_IDS=
WHATSAPP_CONNECTION_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALLOWED_TARGET_IDS=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
