# Copy to workers/.env.voice on the GPU host. Never commit the real file.
VOICE_WORKER_API_KEY=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-separate-long-random-secret
F5_TTS_MODEL=F5TTS_v1_Base
F5_TTS_DEVICE=cuda
F5_TTS_MODEL_LICENSE_CLASS=noncommercial
F5_TTS_JOB_TIMEOUT_SECONDS=240
