# Keep production CORS allowlist to exact origins of your existing app.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local-only worker http is disabled unless explicitly enabled.
WORKER_ALLOW_INSECURE_HTTP=false
