# Shared backend-to-backend secret. Never place this in a public browser bundle.
BACKEND_API_KEY=replace-with-a-long-random-secret

# Multi-provider chat: supply API keys only for providers you plan to use.
# Custom OpenAI-compatible endpoint:
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=

# Hosted model providers (base URLs below are optional overrides where the adapter has a default).
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_DEFAULT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_DEFAULT_MODEL=
TOGETHER_API_KEY=
TOGETHER_BASE_URL=
TOGETHER_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_DEFAULT_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=
FIREWORKS_DEFAULT_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=
CEREBRAS_DEFAULT_MODEL=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_DEFAULT_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_DEFAULT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_DEFAULT_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=
SAMBANOVA_DEFAULT_MODEL=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_DEFAULT_MODEL=
NOVITA_API_KEY=
NOVITA_BASE_URL=
NOVITA_DEFAULT_MODEL=
HYPERBOLIC_API_KEY=
HYPERBOLIC_BASE_URL=
HYPERBOLIC_DEFAULT_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_DEFAULT_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=
HUGGINGFACE_DEFAULT_MODEL=

# Self-hosted/private compatible inference endpoints. These must be reachable securely from Vercel.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_DEFAULT_MODEL=
SGLANG_BASE_URL=
SGLANG_API_KEY=
SGLANG_DEFAULT_MODEL=
LOCALAI_BASE_URL=
LOCALAI_API_KEY=
LOCALAI_DEFAULT_MODEL=
LLAMA_CPP_BASE_URL=
LLAMA_CPP_API_KEY=
LLAMA_CPP_DEFAULT_MODEL=
LMSTUDIO_BASE_URL=
LMSTUDIO_API_KEY=
LMSTUDIO_DEFAULT_MODEL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_DEFAULT_MODEL=

# Optional GitHub repository discovery token (improves API rate limits).
GITHUB_TOKEN=

# Worker URLs and shared worker secrets. Keep URLs HTTPS in production.
VOICE_WORKER_URL=
VOICE_WORKER_API_KEY=
F5_TTS_MODEL_LICENSE_CLASS=noncommercial
MEDIA_WORKER_URL=
MEDIA_WORKER_API_KEY=
AUTOMATION_WORKER_URL=
AUTOMATION_WORKER_API_KEY=
AGENT_WORKER_URL=
AGENT_WORKER_API_KEY=
DESKTOP_AGENT_URL=
DESKTOP_AGENT_API_KEY=
YOUTUBE_WORKER_URL=
YOUTUBE_WORKER_API_KEY=
CHANNEL_WORKER_URL=
CHANNEL_WORKER_API_KEY=

# Keep production CORS allowlist to exact origins of your existing app.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local-only worker http is disabled unless explicitly enabled.
WORKER_ALLOW_INSECURE_HTTP=false
