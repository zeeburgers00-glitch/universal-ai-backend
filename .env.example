# REQUIRED: generate a long random secret; never expose it in a browser/frontend.
BACKEND_API_KEY=replace-with-a-long-random-secret

# Generic OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=

# Optional token for higher GitHub repository-search rate limits.
GITHUB_TOKEN=

# Use your frontend origin(s), comma-separated. Avoid * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
