# Optional GitHub repository discovery token (improves API rate limits).
GITHUB_TOKEN=

# Worker URLs and shared worker secrets. Keep URLs HTTPS in production.
VOICE_WORKER_URL=
VOICE_WORKER_API_KEY=
F5_TTS_MODEL_LICENSE_CLASS=noncommercial
MEDIA_WORKER_URL=
MEDIA_WORKER_API_KEY=
AUTOMATION_WORKER_URL=
AUTOMATION_WORKER_API_KEY=
AGENT_WORKER_URL=
AGENT_WORKER_API_KEY=
DESKTOP_AGENT_URL=
DESKTOP_AGENT_API_KEY=
YOUTUBE_WORKER_URL=
YOUTUBE_WORKER_API_KEY=
CHANNEL_WORKER_URL=
CHANNEL_WORKER_API_KEY=
REA_WORKER_URL=
REA_WORKER_API_KEY=


# Base44 platform integration (server-side personal access token b44u_...; never expose in browser code).
BASE44_ACCESS_TOKEN=
BASE44_API_URL=https://app.base44.com
UNIVERSAL_AI_BACKEND_PUBLIC_URL=https://universal-ai-backend.vercel.app

# Keep production CORS allowlist to exact origins of your existing app (or scoped regex for Base44 preview/live hosts).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN_REGEX=

# Local-only worker http is disabled unless explicitly enabled.
WORKER_ALLOW_INSECURE_HTTP=false

# Additional OpenAI-compatible model gateways (configure only the services you actually use).
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_DEFAULT_MODEL=
HACKER_AI_API_KEY=
HACKER_AI_BASE_URL=https://api.hackerai.sh/v1
HACKER_AI_DEFAULT_MODEL=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_DEFAULT_MODEL=

# Pexels licensed stock-video search (separate from LLM providers).
PEXELS_API_KEY=

# Durable chat / specialist-agent worker
CELERY_BROKER_URL=
AUTOPILOT_MAX_PARALLEL_AGENTS=5
AUTOPILOT_MODEL_BASE_URL=
AUTOPILOT_MODEL_API_KEY=
AUTOPILOT_DEFAULT_MODEL=

# Metricool (Advanced or Custom plan for API access)
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# ---- model providers (the command layer tries these in order) ----
# Any ONE of them is enough to write real scripts. More keys = automatic
# failover when one is rate-limited or out of credit.
# Override the order with: AI_PROVIDER_ORDER=mistral,groq,openrouter
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-large-latest

ZAI_API_KEY=
ZAI_DEFAULT_MODEL=glm-4.6

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct

HF_API_KEY=
HF_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# These two need a base URL from the provider dashboard before they are usable.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=
OPENCODE_ZEN_DEFAULT_MODEL=

HACKERAI_API_KEY=
HACKERAI_BASE_URL=
HACKERAI_DEFAULT_MODEL=

# ---- stock footage (real b-roll instead of colour cards) ----
PEXELS_API_KEY=

# ---- Claude: the brain, when you bring a key ----
# Speaks the Anthropic Messages API (not OpenAI-compatible). Paid, your key.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- free tool belt ----
# Network tools (httpx, ntfy, feeds) stay off until you opt in.
UAI_TOOLS_ALLOW_NETWORK=0

# ---- character / mood / self layer ----
# UAI_AFFECT_DISABLED=1 pins the mood to baseline (flat, professional voice)
# UAI_REFLECT_EVERY=25 turns between automatic reflections (0 disables)

# ---- Gmail accounts (consent flow, one per mailbox) ----
# console.cloud.google.com -> enable Gmail API -> OAuth client (Web application)
# redirect URI: http://127.0.0.1:8000/v1/accounts/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/v1/accounts/oauth/callback
# Sending needs the gmail.send scope AND UAI_REQUIRE_APPROVAL=1 for the approval token.

# ---- Kaggle batch jobs (API token, not compute) ----
# kaggle.com -> Account -> Create New Token -> ~/.kaggle/kaggle.json
# or set both of these. Without them /v1/kaggle/* answers "unavailable".
KAGGLE_USERNAME=
KAGGLE_KEY=
# KAGGLE_CONFIG_DIR=~/.kaggle
