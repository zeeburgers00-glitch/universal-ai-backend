# Copy to .env. Replace generated secrets before exposing the API.
BACKEND_API_KEY=CHANGE_ME_backend_api_key
REDIS_PASSWORD=CHANGE_ME_redis_password
DATA_DIR=/opt/universal-ai-backend/data
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WORKER_ALLOW_INSECURE_HTTP=true

# Six CPU worker services (loopback only; worker ports must not be public).
YOUTUBE_WORKER_URL=http://127.0.0.1:8200
YOUTUBE_WORKER_API_KEY=CHANGE_ME_youtube_worker_key
CHANNEL_WORKER_URL=http://127.0.0.1:8300
CHANNEL_WORKER_API_KEY=CHANGE_ME_channel_worker_key
MEDIA_WORKER_URL=http://127.0.0.1:8400
MEDIA_WORKER_API_KEY=CHANGE_ME_media_worker_key
AGENT_WORKER_URL=http://127.0.0.1:8500
AGENT_WORKER_API_KEY=CHANGE_ME_agent_worker_key
AUTOMATION_WORKER_URL=http://127.0.0.1:8600
AUTOMATION_WORKER_API_KEY=CHANGE_ME_automation_worker_key
REA_WORKER_URL=http://127.0.0.1:8700
REA_WORKER_API_KEY=CHANGE_ME_rea_worker_key

# Optional remote GPU voice worker. Keep empty until a real HTTPS worker is deployed.
VOICE_WORKER_URL=
VOICE_WORKER_API_KEY=
F5_TTS_MODEL_LICENSE_CLASS=noncommercial

# Optional inference and stock footage providers.
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-large-latest
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
ZAI_API_KEY=
ZAI_DEFAULT_MODEL=glm-4.6
HUGGINGFACE_API_KEY=
HUGGINGFACE_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct
PEXELS_API_KEY=

# Durable storage is optional; configure a private Supabase project for persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
