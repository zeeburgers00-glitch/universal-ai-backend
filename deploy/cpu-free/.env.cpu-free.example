# Free CPU-only deployment. Copy to .env on the host; never commit real secrets.
DATA_DIR=/opt/universal-ai-backend/data
PUBLIC_PORT=8000
REDIS_PASSWORD=replace-with-a-long-random-secret
BACKEND_API_KEY=replace-with-a-long-random-secret

# Local worker services (host networking; API binds to loopback).
YOUTUBE_WORKER_URL=http://127.0.0.1:8200
YOUTUBE_WORKER_API_KEY=replace-with-a-long-random-secret
CHANNEL_WORKER_URL=http://127.0.0.1:8300
CHANNEL_WORKER_API_KEY=replace-with-a-long-random-secret
MEDIA_WORKER_URL=http://127.0.0.1:8400
MEDIA_WORKER_API_KEY=replace-with-a-long-random-secret
AGENT_WORKER_URL=http://127.0.0.1:8500
AGENT_WORKER_API_KEY=replace-with-a-long-random-secret
AUTOMATION_WORKER_URL=http://127.0.0.1:8600
AUTOMATION_WORKER_API_KEY=replace-with-a-long-random-secret
REA_WORKER_URL=http://127.0.0.1:8700
REA_WORKER_API_KEY=replace-with-a-long-random-secret

# Voice is intentionally disabled on this CPU-only host. A remote GPU worker must be HTTPS.
VOICE_WORKER_URL=
VOICE_WORKER_API_KEY=

# Optional provider keys. Empty means the corresponding provider is unavailable.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
PEXELS_API_KEY=

# Built-in cloud worker runtime remains opt-in.
ENABLE_BUILTIN_CLOUD_RUNTIME=false
WORKER_ALLOW_INSECURE_HTTP=true
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Agent Runtime: SQLite lives on the mounted DATA_DIR volume. Execution remains disabled by default.
AGENT_RUNTIME_DB_PATH=/data/agent-runtime/agent_runtime.sqlite3
AGENT_RUNTIME_MAX_PENDING_TASKS=1000
AGENT_RUNTIME_WORKER_NO_CARD_CONFIRMED=false
OPENAVATAR_DB_PATH=/data/openavatar.sqlite3
OPENAVATAR_DATA_DIR=/data/openavatar
