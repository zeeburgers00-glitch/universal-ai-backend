# Free-tier CPU stack (Oracle Cloud Always Free / any small VM).
# Copy to .env and fill the CHANGE_ME values:
#     cp .env.cpu-free.example .env && chmod 600 .env
# bootstrap.sh does this for you and generates every secret automatically.

# ---------------------------------------------------------------- core ----
BACKEND_API_KEY=CHANGE_ME_backend_key
REDIS_PASSWORD=CHANGE_ME_redis_password
UNIVERSAL_AI_BACKEND_PUBLIC_URL=http://CHANGE_ME_your_ip:8000

# Comma-separated browser origins allowed to call the API (your apps).
CORS_ORIGINS=https://app.base44.com

# Where rendered media lives on the host. Mounted into every container.
DATA_DIR=/opt/universal-ai-backend/data

# Workers are reached over plain HTTP on loopback, which the API only allows
# when this flag is set. Never expose a worker port to the internet.
WORKER_ALLOW_INSECURE_HTTP=true

# ------------------------------------------------------------- workers ----
# Ports are fixed: api 8000, voice 8100, youtube 8200, channel 8300,
# media 8400, agent 8500, automation 8600, rea 8700.
YOUTUBE_WORKER_URL=http://127.0.0.1:8200
YOUTUBE_WORKER_API_KEY=CHANGE_ME_youtube_key
CHANNEL_WORKER_URL=http://127.0.0.1:8300
CHANNEL_WORKER_API_KEY=CHANGE_ME_channel_key
MEDIA_WORKER_URL=http://127.0.0.1:8400
MEDIA_WORKER_API_KEY=CHANGE_ME_media_key
AGENT_WORKER_URL=http://127.0.0.1:8500
AGENT_WORKER_API_KEY=CHANGE_ME_agent_key
AUTOMATION_WORKER_URL=http://127.0.0.1:8600
AUTOMATION_WORKER_API_KEY=CHANGE_ME_automation_key
REA_WORKER_URL=http://127.0.0.1:8700
REA_WORKER_API_KEY=CHANGE_ME_rea_key

# voice_worker is NOT part of this stack: it needs a CUDA GPU. Leave these
# empty and /v1/voice/* answers 503 honestly. To enable voice, run the worker
# on a GPU host (deploy/modal, deploy/runpod or deploy/kaggle) and put its
# HTTPS URL here. Plain http:// is only accepted for 127.0.0.1.
VOICE_WORKER_URL=
VOICE_WORKER_API_KEY=

# --------------------------------------------------------------- celery ----
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6379/0

# ------------------------------------------------------- model providers ----
# One is enough. More keys = automatic failover, see docs/API_KEYS.md.
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-large-latest
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
ZAI_API_KEY=
ZAI_DEFAULT_MODEL=glm-4.6
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
HF_API_KEY=
HF_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --------------------------------------------------------------- extras ----
PEXELS_API_KEY=
METRICOOL_API_TOKEN=
GITHUB_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
