[Unit]
Description=Universal AI Backend (free-tier CPU stack)
Documentation=https://github.com/zeeburgers00-glitch/universal-ai-backend
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/universal-ai-backend/deploy/cpu-free
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart api
TimeoutStartSec=600
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
