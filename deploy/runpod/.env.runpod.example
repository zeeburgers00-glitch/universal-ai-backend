# RunPod GPU pod: the full backend including voice_worker.
# Copy to .env and fill the CHANGE_ME values, then:
#     docker compose up -d --build
#
# All services share host networking, so every worker is reachable on
# 127.0.0.1 at its own port. Only 8000 should ever be exposed publicly.

# ---------------------------------------------------------------- core ----
BACKEND_API_KEY=CHANGE_ME_backend_key
REDIS_PASSWORD=CHANGE_ME_redis_password
UNIVERSAL_AI_BACKEND_PUBLIC_URL=http://CHANGE_ME_your_ip:8000
CORS_ORIGINS=https://app.base44.com
DATA_DIR=/workspace/data
WORKER_ALLOW_INSECURE_HTTP=true

# ------------------------------------------------------------- workers ----
VOICE_WORKER_URL=http://127.0.0.1:8100
VOICE_WORKER_API_KEY=CHANGE_ME_voice_key
YOUTUBE_WORKER_URL=http://127.0.0.1:8200
YOUTUBE_WORKER_API_KEY=CHANGE_ME_youtube_key
CHANNEL_WORKER_URL=http://127.0.0.1:8300
CHANNEL_WORKER_API_KEY=CHANGE_ME_channel_key
MEDIA_WORKER_URL=http://127.0.0.1:8400
MEDIA_WORKER_API_KEY=CHANGE_ME_media_key
AGENT_WORKER_URL=http://127.0.0.1:8500
AGENT_WORKER_API_KEY=CHANGE_ME_agent_key
AUTOMATION_WORKER_URL=http://127.0.0.1:8600
AUTOMATION_WORKER_API_KEY=CHANGE_ME_automation_key
REA_WORKER_URL=http://127.0.0.1:8700
REA_WORKER_API_KEY=CHANGE_ME_rea_key

# Prebuilt image published by deploy/ghcr/voice-worker-image.yml.
# Set this and run `docker compose up -d --no-build` to skip a ~15 min build.
#   ghcr.io/<github-owner>/universal-ai-voice-worker:latest
VOICE_WORKER_IMAGE=

# --------------------------------------------------------------- celery ----
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6379/0

# ------------------------------------------------------- model providers ----
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-large-latest
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
ZAI_API_KEY=
ZAI_DEFAULT_MODEL=glm-4.6
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
HF_API_KEY=
HF_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --------------------------------------------------------------- extras ----
PEXELS_API_KEY=
METRICOOL_API_TOKEN=
GITHUB_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
